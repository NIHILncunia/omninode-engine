{
  "name": "nuxt-template",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "icon:gen": "tsx app/scripts/generate-icon-types.ts",
    "db:dev:generate": "drizzle-kit generate --config=drizzle.dev.config.ts",
    "db:dev:push": "drizzle-kit push --config=drizzle.dev.config.ts",
    "db:prod:generate": "drizzle-kit generate --config=drizzle.prod.config.ts",
    "db:prod:migrate": "drizzle-kit migrate --config=drizzle.prod.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@element-plus/nuxt": "1.1.5",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify/utils": "^3.1.4",
    "@nuxt/image": "2.1.0",
    "@pinia/nuxt": "^1.0.1",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-query-devtools": "^6.1.38",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "element-plus": "^2.14.4",
    "lodash-unified": "^1.0.3",
    "luxon": "^3.7.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.2",
    "postgres": "^3.4.9",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify/types": "^2.0.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
